[ext_resource type="Script" path="res://addons/func_godot/src/fgd/func_godot_fgd_point_class.gd" id="1_point"]
[ext_resource type="PackedScene" path="res://gameplay/doors/OrdinaryDoor.tscn" id="2_scene"]

[resource]
script = ExtResource("1_point")
classname = "vark_opening"
description = "Reusable ordinary door/openable-window archetype. Gameplay identity, interaction, restriction state, obstruction, sound/nav/vision seams, events, and save state stay on the shared opening; visual_model_path/opening_variant select compatible presentation."
class_properties = Dictionary[String, Variant]({
"persistent_id": "",
"door_id": "",
"opening_variant": "ordinary",
"visual_model_path": "res://assets/models/doors/ordinary_door_leaf.obj",
"base_color": Color(0.34, 0.20, 0.10, 1),
"transition_seconds": 0.55,
"open_angle_degrees": 90.0,
"gameplay_sound_strength": 0.65,
"starts_locked": false,
"required_key_id": "",
"starts_barred": false,
"angle": 180.0
})
class_property_descriptions = Dictionary[String, Variant]({
"persistent_id": "Required stable authored identity for save/restore. Moving or changing the visual model must not replace this identity.",
"door_id": "Required unique semantic opening address consumed by acoustics, NPC navigation, events, and mission logic.",
"opening_variant": "Presentation/content label such as wooden, metal, ornate, or window_like. It does not select a separate gameplay subsystem.",
"visual_model_path": "Godot res:// path to a compatible external Mesh. The shared OrdinaryDoor scene/collision/gameplay owner remains unchanged.",
"base_color": "Default door-surface tint used by the current low-fi presentation/highlight path.",
"transition_seconds": "Seconds for a complete physical open/close transition.",
"open_angle_degrees": "Yaw angle of the fully open leaf relative to its authored closed transform.",
"gameplay_sound_strength": "Relative semantic gameplay-sound strength emitted when physical motion begins.",
"starts_locked": "Start closed and locked. If required_key_id is non-empty, a requester must report semantic possession of that key to unlock.",
"required_key_id": "Semantic key possession ID queried from the requester. The door never owns or consumes inventory.",
"starts_barred": "Start closed and externally restricted. Barred openings cannot be opened by a key and must be unbarred by world/mission logic.",
"angle": "Initial TrenchBroom yaw of the closed opening."
})
auto_apply_to_matching_node_properties = true
scene_file = ExtResource("2_scene")
node_groups = Array[String](["vark_interactable"])

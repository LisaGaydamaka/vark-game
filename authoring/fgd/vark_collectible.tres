"content_id": "",
"pickup_kind_name": {"Loot": "loot", "Key": "key", "Mission item": "mission_item"},
"pickup_variant": {"Brass key": "brass_key", "Gold cup": "gold_cup", "Silver candlestick": "silver_candlestick", "Sealed scroll": "sealed_scroll"},
"loot_value": 0,
"display_label": "Collectible",
"angle": 180.0
})
class_property_descriptions = Dictionary[String, Variant]({
"persistent_id": "Required stable authored identity for save tombstones.",
"content_id": "Semantic pickup/possession ID.",
"pickup_kind_name": "Mapper string converted into the collectible's existing semantic pickup_kind after FuncGodot applies properties.",
"pickup_variant": "Shared imported-model collectible asset.",
"loot_value": "Run loot value. Use zero for keys and mission items.",
"display_label": "Interaction label.",
"angle": "Initial TrenchBroom yaw."
})

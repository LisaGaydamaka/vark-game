[ext_resource type="Script" path="res://addons/func_godot/src/fgd/func_godot_fgd_point_class.gd" id="1_point"]
[ext_resource type="Script" path="res://missions/persistence/persistent_entity.gd" id="2_persistent"]

[resource]
script = ExtResource("1_point")
classname = "vark_exit"
description = "Authored semantic mission-exit endpoint. This Phase-2 point is addressable spatial content only; objective/exit gameplay arrives later."
class_properties = Dictionary[String, Variant]({
"persistent_id": "",
"content_id": "",
"angle": 180.0
})
class_property_descriptions = Dictionary[String, Variant]({
"persistent_id": "Stable Vark persistent identity. Do not edit manually; Vark authoring tooling assigns/repairs this value.",
"content_id": "Optional author-facing semantic ID such as door.vault or guard.library. This is separate from persistent_id and is not generated automatically.",
"angle": "Exit endpoint facing direction in TrenchBroom degrees."
})
auto_apply_to_matching_node_properties = true
node_class = "Node3D"
script_class = ExtResource("2_persistent")
node_groups = Array[String](["vark_mission_exit"])

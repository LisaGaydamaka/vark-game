class_property_descriptions = Dictionary[String, Variant]({
"persistent_id": "Stable authored persistent identity for this actor. The same ID survives conscious/unconscious/dead life-state changes.",
"content_id": "Optional authored semantic actor address. This is separate from persistent_id and guard navigation IDs.",
"guard_id": "Required guard ID for the Phase 3.7 navigation proof and semantic actor reference used by the Phase 3.11 compatibility proof.",
"patrol_a_id": "First authored vark_patrol_point ID.",
"patrol_b_id": "Second authored vark_patrol_point ID.",
"door_id": "Ordinary door ID this guard is allowed to use while following the current proof route.",
"movement_speed": "Patrol movement speed in Vark world meters per second.",
"door_use_distance": "Maximum horizontal relevance range for the configured ordinary door. The guard requests OPEN only when the door's current collider physically blocks its near-future NavigationAgent route and it has reached the safe swing-clearance stop boundary; a partially open passable leaf is ignored.",
"angle": "Initial TrenchBroom facing direction."
})

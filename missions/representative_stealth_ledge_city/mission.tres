mission_rule_declarations = Array[Dictionary]([{"actions": [{"event_name": &"objective.complete_requested", "kind": &"emit_event", "payload": {"objective_id": &"objective.dev_stealth.ledger"}}], "conditions": [{"key": &"content_id", "kind": &"event_payload_equals", "value": "mission.dev_stealth.ledger"}, {"key": &"kind", "kind": &"event_payload_equals", "value": &"mission_item"}], "event_name": &"pickup.collected", "repeat": false, "rule_id": &"rule.dev_stealth.complete_ledger"}, {"actions": [{"event_name": &"alarm.raise_requested", "kind": &"emit_event", "payload": {"alarm_id": &"alarm.dev_stealth", "evidence_position": Vector3(-15.625, 12.5, -7.8125), "source_actor_id": "mission.ledger"}}], "conditions": [{"key": &"content_id", "kind": &"event_payload_equals", "value": "mission.dev_stealth.ledger"}], "event_name": &"pickup.collected", "repeat": false, "rule_id": &"rule.dev_stealth.raise_alarm"}])

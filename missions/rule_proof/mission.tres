[gd_resource type="Resource" script_class="MissionDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://missions/mission_definition.gd" id="1_definition"]
[ext_resource type="PackedScene" path="res://missions/rule_proof/world.tscn" id="2_world"]

[resource]
script = ExtResource("1_definition")
mission_id = &"phase8_rule_proof"
world_scene = ExtResource("2_world")
map_source_path = "res://missions/rule_proof/mission.map"
player_start_selector = &"default"
mission_content_revision = 1
mission_fact_declarations = Array[Dictionary]([{"default": false, "key": &"security_cut", "scope": &"mission", "type": &"bool"}])
mission_rule_declarations = Array[Dictionary]([{"actions": [{"key": &"security_cut", "kind": &"set_fact", "value": true}], "conditions": [{"key": &"switch_id", "kind": &"event_payload_equals", "value": "phase8.rule.switch"}, {"key": &"enabled", "kind": &"event_payload_equals", "value": false}], "event_name": &"switch.used", "repeat": false, "rule_id": &"rule.security_cut.latch"}, {"actions": [{"event_name": &"objective.activate_requested", "kind": &"emit_event", "payload": {"objective_id": &"objective.security_cut"}}], "conditions": [{"key": &"key", "kind": &"event_payload_equals", "value": &"security_cut"}, {"key": &"value", "kind": &"event_payload_equals", "value": true}, {"key": &"security_cut", "kind": &"fact_equals", "value": true}], "event_name": &"mission.fact_changed", "repeat": false, "rule_id": &"rule.security_cut.activate_objective"}])

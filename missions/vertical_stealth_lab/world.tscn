offset_top = 130.0
offset_right = 430.0
offset_bottom = 232.0

[node name="VBox" type="VBoxContainer" parent="ExposureHUD/NoisePanel"]

[node name="Title" type="Label" parent="ExposureHUD/NoisePanel/VBox"]

material_override = SubResource("TileMarkerMaterial")

[node name="Label" type="Label3D" parent="TileMarker"]
position = Vector3(0, 0.35, 0)
text = "TILE / LOUD STEPS"
billboard = 1
font_size = 19
outline_size = 6
no_depth_test = true

[node name="FootstepEmitter" type="Node" parent="."]
script = ExtResource("18_footsteps")
player_path = NodePath("../Player")
step_distance = 1.25
minimum_move_speed = 0.35
crouched_strength_scale = 0.45

[node name="CrateA" parent="." instance=ExtResource("4_prop")]
position = Vector3(-2.5, 0.3, 8.5)
persistent_id = "vertical.prop.a"
prop_id = &"prop.vertical.a"

[node name="CrateB" parent="." instance=ExtResource("4_prop")]
position = Vector3(-1.5, 0.3, 8.5)
persistent_id = "vertical.prop.b"
prop_id = &"prop.vertical.b"


[node name="CrateC" parent="." instance=ExtResource("4_prop")]
position = Vector3(3.5, 0.3, -7.5)
persistent_id = "vertical.prop.c"
prop_id = &"prop.vertical.c"

[node name="CrateD" parent="." instance=ExtResource("4_prop")]
position = Vector3(4.5, 0.3, -7.5)
persistent_id = "vertical.prop.d"
prop_id = &"prop.vertical.d"

[node name="ObjectiveState" type="Node" parent="."]
script = ExtResource("14_objective")
objective_id = &"objective.vertical"
exit_id = &"exit.vertical"
objective_text = "Climb to the upper objective, evade the guard, and return to EXIT."
status_label_path = NodePath("../ObjectiveStatus")

[node name="ObjectiveTrigger" type="Area3D" parent="."]
position = Vector3(-7.5, 4.75, -10.5)
collision_layer = 0
collision_mask = 2
script = ExtResource("15_trigger")
event_name = &"objective.complete_requested"
payload_key = &"objective_id"
payload_id = &"objective.vertical"
one_shot_on_queue = true

[node name="CollisionShape3D" type="CollisionShape3D" parent="ObjectiveTrigger"]
shape = SubResource("TriggerShape")

[node name="Pad" type="MeshInstance3D" parent="ObjectiveTrigger"]
position = Vector3(0, -0.48, 0)
mesh = SubResource("MarkerMesh")
material_override = SubResource("ObjectiveMarkerMaterial")

[node name="Label" type="Label3D" parent="ObjectiveTrigger"]
position = Vector3(0, 1.25, 0)
text = "OBJECTIVE"
billboard = 1
font_size = 26
outline_size = 8
no_depth_test = true

[node name="ExitTrigger" type="Area3D" parent="."]
position = Vector3(-8, 0.5, 12)
collision_layer = 0
collision_mask = 2
script = ExtResource("15_trigger")
event_name = &"mission.exit_requested"
payload_key = &"exit_id"
payload_id = &"exit.vertical"

[node name="CollisionShape3D" type="CollisionShape3D" parent="ExitTrigger"]
shape = SubResource("TriggerShape")

[node name="Pad" type="MeshInstance3D" parent="ExitTrigger"]
position = Vector3(0, -0.48, 0)
mesh = SubResource("MarkerMesh")
material_override = SubResource("ExitMarkerMaterial")

[node name="Label" type="Label3D" parent="ExitTrigger"]
position = Vector3(0, 1.25, 0)
text = "EXIT"
billboard = 1
font_size = 26
outline_size = 8
no_depth_test = true

[node name="ObjectiveStatus" type="Label3D" parent="."]
position = Vector3(-8.5, 2.4, 11.8)
text = "OBJECTIVE ACTIVE"
billboard = 1
font_size = 19
outline_size = 7
no_depth_test = true

[node name="Instructions" type="Label3D" parent="."]
position = Vector3(-3.5, 4.3, 11.8)
text = "VERTICAL STEALTH LAB\nClimb the west-side steps/catwalk to the tower OBJECTIVE, then return to EXIT.\nThe guard patrols the long east route and waits at both endpoints.\nUse height, cover, darkness, carpet/stone/tile, landings, and distractions to test stealth."
billboard = 1
font_size = 18
outline_size = 7
no_depth_test = true

[node name="ExposureHUD" type="CanvasLayer" parent="."]

[node name="Panel" type="PanelContainer" parent="ExposureHUD"]
script = ExtResource("21_light_gem")
exposure_path = NodePath("../../GameplayExposure")
offset_left = 16.0
offset_top = 16.0
offset_right = 430.0
offset_bottom = 118.0

[node name="VBox" type="VBoxContainer" parent="ExposureHUD/Panel"]

[node name="Title" type="Label" parent="ExposureHUD/Panel/VBox"]
text = "5.3 LIGHT GEM / EXPOSURE"

[node name="ExposureBar" type="ProgressBar" parent="ExposureHUD/Panel/VBox"]
custom_minimum_size = Vector2(390, 18)
max_value = 1.0
step = 0.01
show_percentage = false

[node name="Readout" type="Label" parent="ExposureHUD/Panel/VBox"]
text = "EXPOSURE 0.00"

[node name="NoisePanel" type="PanelContainer" parent="ExposureHUD"]

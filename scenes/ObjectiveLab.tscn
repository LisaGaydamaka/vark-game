objective_declarations = Array[Dictionary]([{"initial_state": &"active", "objective_id": &"objective.route", "optional": false, "text": "Reach the OBJECTIVE marker."}, {"initial_state": &"inactive", "objective_id": &"objective.bonus", "optional": true, "text": "Visit the OPTIONAL marker."}, {"initial_state": &"active", "objective_id": &"objective.no_alarm", "optional": true, "text": "Avoid the optional alarm condition."}])

